import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/json",
}

///|
async fn main {
  let expected = "89b500f5e1d98ed89bb90211e45b28730b2d99ac"
  let revision = @shell.Cmd("git", ["-C", "reference/pdf.js", "rev-parse", "HEAD"]).output()
  guard revision.exit_code() == 0 && revision.stdout().trim() == expected else {
    fail("CMap assets require the pinned PDF.js revision " + expected)
  }
  let source = "reference/pdf.js/external/bcmaps"
  let names : Array[String] = []
  let output = StringBuilder()
  output.write_string(
    "// Generated by tools/cmap_assets.mbtx from PDF.js " + expected + ".\n" +
    "// Copyright 1990-2009 Adobe Systems Incorporated.\n" +
    "// Redistribution terms: assets/cmaps/LICENSE.\n\n" +
    "///|\npub fn lookup(name : String) -> Bytes? {\n" +
    "  let encoded = match name {\n",
  )
  for filename in @fs.readdir(source, sort=true) {
    if !filename.has_suffix(".bcmap") {
      continue
    }
    let name = filename[0:filename.length() - 6].to_owned()
    names.push(name)
    let encoded = @base64.encode(@fs.read_file(source + "/" + filename).binary())
    output.write_string("    " + Json::string(name).stringify() + " => {\n      let value =\n")
    let mut offset = 0
    while offset < encoded.length() {
      let end = (offset + 120).min(encoded.length())
      output.write_string("        #|" + encoded[offset:end].to_owned() + "\n")
      offset = end
    }
    output.write_string("      value\n    }\n")
  }
  output.write_string("    _ => return None\n  }\n  Some(@base64.decode(encoded, ignore_whitespace=true)) catch { _ => None }\n}\n")
  let inventory = StringBuilder()
  inventory.write_string("// Generated by tools/cmap_assets.mbtx.\n///|\nfn pdf_builtin_cmap_names() -> Array[String] {\n  [\n")
  for name in names {
    inventory.write_string("    " + Json::string(name).stringify() + ",\n")
  }
  inventory.write_string("  ]\n}\n")
  if !@fs.exists("assets/cmaps") {
    @fs.mkdir("assets/cmaps", recursive=true)
  }
  @fs.write_file("assets/cmaps/LICENSE", @fs.read_file(source + "/LICENSE").binary())
  @fs.write_file("internal/cmap_assets/assets.mbt", output.to_string())
  @fs.write_file("internal/engine/builtin_cmap_assets_wbtest.mbt", inventory.to_string())
  println("Embedded \{names.length()} CMaps from " + expected)
}
