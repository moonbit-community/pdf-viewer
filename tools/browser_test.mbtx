///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/async/shell",
  "moonbitlang/async/http",
  "moonbitlang/async/websocket",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/pdflite",
}

///|
struct Browser {
  socket : @websocket.Conn
  browser_url : String
  mut id : Int
  errors : Array[Json]
  checks : Array[String]
}

///|
async fn Browser::command(
  self : Browser,
  operation : String,
  params? : Json = {},
  session? : String,
) -> Json {
  self.id += 1
  let id = self.id
  let request : Json = match session {
    Some(session) => {
      "id": id,
      "method": operation,
      "params": params,
      "sessionId": session,
    }
    None => { "id": id, "method": operation, "params": params }
  }
  self.socket.send_text(request.stringify())
  for ;; {
    let message = @async.with_timeout(30000, () => {
      self.socket.recv().read_all().text()
    })
    let response = @json.parse(message)
    match response {
      { "id": Number(value, ..), "error": error, .. } if value == id.to_double() =>
        fail("CDP error: " + error.stringify())
      { "id": Number(value, ..), "result": result, .. } if value ==
        id.to_double() => return result
      { "method": String("Runtime.exceptionThrown"), .. } =>
        self.errors.push(response)
      _ => ()
    }
  }
}

///|
async fn Browser::evaluate(self : Browser, expression : String) -> Json {
  let response = self.command("Runtime.evaluate", params={
    "expression": expression,
    "awaitPromise": true,
    "returnByValue": true,
  })
  match response {
    { "exceptionDetails": error, .. } =>
      fail("Browser evaluation: " + error.stringify())
    { "result": { "value": value, .. }, .. } => value
    _ => fail("Missing browser value: " + response.stringify())
  }
}

///|
async fn Browser::check(
  self : Browser,
  name : String,
  expression : String,
) -> Unit {
  let result = self.evaluate(expression)
  guard result == Json::boolean(true) else {
    fail("Browser assertion failed (" + name + "): " + result.stringify())
  }
  println("PASS: " + name)
  self.checks.push(name)
}

///|
async fn Browser::wait(self : Browser, condition : String) -> Unit {
  for _ in 0..<1000 {
    if self.evaluate(condition) == Json::boolean(true) {
      return
    }
    @async.sleep(25)
  }
  fail("Browser condition did not complete: " + condition)
}

///|
async fn Browser::ready(self : Browser, expected_pages : Int) -> Unit {
  let page_condition = if expected_pages < 0 {
    "document.querySelectorAll('.page').length > 0"
  } else {
    "document.querySelectorAll('.page').length === \{expected_pages}"
  }
  for _ in 0..<400 {
    if self.evaluate(
        page_condition +
        " && document.getElementById('viewer').getAttribute('aria-busy') === 'false'",
      ) ==
      Json::boolean(true) {
      return
    }
    @async.sleep(25)
  }
  let error = self.evaluate(
    "({error: document.getElementById('error')?.textContent, status: document.getElementById('status')?.textContent, pages: document.querySelectorAll('.page').length})",
  )
  fail("Viewer did not become ready: " + error.stringify())
}

///|
async fn Browser::navigate(self : Browser, url : String, pages : Int) -> Unit {
  ignore(self.command("Page.navigate", params={ "url": url }))
  // Wait until the new document has loaded before asking for its page state.
  for _ in 0..<400 {
    if self.evaluate(
        "location.href === " +
        Json::string(url).stringify() +
        " && document.readyState === 'complete'",
      ) ==
      Json::boolean(true) {
      break
    }
    @async.sleep(25)
  }
  self.ready(pages)
}

///|
async fn Browser::screenshot(self : Browser, path : String) -> Unit {
  let result = self.command("Page.captureScreenshot", params={ "format": "png" })
  guard result is { "data": String(data), .. } else {
    fail("Missing screenshot")
  }
  @fs.write_file(path, @base64.decode(data))
}

///|
async fn Browser::upload(self : Browser, filename : String) -> Unit {
  let document = self.command("DOM.getDocument")
  guard document is { "root": { "nodeId": Number(root, ..), .. }, .. } else {
    fail("Missing root node")
  }
  let found = self.command("DOM.querySelector", params={
    "nodeId": root,
    "selector": "#file-input",
  })
  guard found is { "nodeId": Number(node, ..), .. } else {
    fail("Missing file input")
  }
  ignore(
    self.command("DOM.setFileInputFiles", params={
      "nodeId": node,
      "files": [filename],
    }),
  )
}

///|
async fn Browser::heap(self : Browser, collect? : Bool = false) -> Json {
  if collect {
    ignore(self.command("HeapProfiler.collectGarbage"))
  }
  let main = self.command("Runtime.getHeapUsage")
  // Flattened Worker sessions route through the browser endpoint. Sending
  // their sessionId to a page endpoint silently stalls on Chromium.
  let remote : Browser = {
    socket: @websocket.connect(self.browser_url),
    browser_url: self.browser_url,
    id: 0,
    errors: self.errors,
    checks: self.checks,
  }
  defer remote.socket.close()
  let targets = remote.command("Target.getTargets")
  let mut worker : Json = Json::null()
  match targets {
    { "targetInfos": Array(targets), .. } =>
      for target in targets {
        if target
          is {
            "type": String("worker"),
            "url": String(url),
            "targetId": String(id),
            ..
          } &&
          (url.is_empty() || url.has_suffix("/pdf-worker.js")) {
          let attached = remote.command("Target.attachToTarget", params={
            "targetId": id,
            "flatten": true,
          })
          guard attached is { "sessionId": String(session), .. } else {
            fail("Unable to measure Worker heap")
          }
          let location = remote.command("Runtime.evaluate", session~, params={
            "expression": "location.href",
            "returnByValue": true,
          })
          if collect {
            ignore(remote.command("HeapProfiler.collectGarbage", session~))
          }
          worker = remote.command("Runtime.getHeapUsage", session~)
          ignore(
            remote.command("Target.detachFromTarget", params={ "sessionId": session }),
          )
          if location
            is { "result": { "value": String(url), .. }, .. } &&
            url.has_suffix("/pdf-worker.js") {
            break
          }
          worker = Json::null()
        }
      }
    _ => fail("Missing Worker targets")
  }
  guard worker != Json::null() else { fail("No PDF Worker to measure: " + targets.stringify()) }
  { "main": main, "worker": worker }
}

///|
/// Authored pressure fixtures: many cheap pages and independent raw images.
/// ASCII samples make byte lengths exact, including the actual xref offsets.
fn host_test_document(count : Int, images? : Bool = false) -> Bytes {
  let font = 3 + count * 2
  let objects = [
    "<< /Type /Catalog /Pages 2 0 R >>",
    "<< /Type /Pages /Count \{count} /Kids [" +
    [ for number in 0..<count => "\{number + 3} 0 R" ].join(" ") +
    "] >>",
  ]
  for number in 1..<=count {
    let extra = if number % 10 == 0 { "/Rotate 90 /UserUnit 1.5" } else { "" }
    let resource = if images { "/XObject << /Im \{font + number} 0 R >>" } else { "" }
    objects.push(
      "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] " +
      "\{extra} /Contents \{count + 2 + number} 0 R /Resources << /Font << /F1 \{font} 0 R >> \{resource} >> >>",
    )
  }
  for number in 1..<=count {
    let image = if images { "q 512 0 0 512 40 160 cm /Im Do Q\n" } else { "" }
    let contents = image +
      "BT /F1 20 Tf 40 720 Td (Host page " +
      number.to_string().pad_start(3, '0') +
      ") Tj ET"
    objects.push(
      "<< /Length \{contents.length()} >>\nstream\n\{contents}\nendstream",
    )
  }
  objects.push("<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>")
  if images {
    for number in 1..<=count {
      let samples = StringBuilder()
      let mut seed = number * 97
      for _ in 0..<(512 * 512 * 3) {
        seed = (seed * 1103515245 + 12345) & 0x7fffffff
        samples.write_char(Char::from_int(32 + (seed >> 16) % 95))
      }
      objects.push(
        "<< /Type /XObject /Subtype /Image /Width 512 /Height 512 /ColorSpace /DeviceRGB /BitsPerComponent 8 /Length 786432 >>\nstream\n" +
        samples.to_string() +
        "\nendstream",
      )
    }
  }
  let output = StringBuilder()
  output.write_string("%PDF-1.7\n")
  let offsets : Array[Int] = []
  let mut length = 9
  for index, object in objects {
    offsets.push(length)
    let chunk = "\{index + 1} 0 obj\n\{object}\nendobj\n"
    output.write_string(chunk)
    length += chunk.length()
  }
  output.write_string("xref\n0 \{objects.length() + 1}\n0000000000 65535 f \n")
  for offset in offsets {
    output.write_string(offset.to_string().pad_start(10, '0') + " 00000 n \n")
  }
  output.write_string(
    "trailer\n<< /Size \{objects.length() + 1} /Root 1 0 R >>\nstartxref\n\{length}\n%%EOF\n",
  )
  @utf8.encode(output.to_string())
}

///|
async fn Browser::drag(self : Browser, first : String, last : String) -> Unit {
  let expression =
    #| ((firstText, lastText) => {
    #|   // Start a new selection; dragging existing selected text starts native DnD.
    #|   getSelection().removeAllRanges();
    #|   const glyphs = [...document.querySelectorAll('.glyph')];
    #|   const first = glyphs.find(g => g.textContent === firstText);
    #|   const last = glyphs.find(g => g.textContent === lastText);
    #|   first.scrollIntoView({block: 'center', inline: 'center'});
    #|   const point = (glyph, fraction) => {
    #|     const page = glyph.closest('.page').getBoundingClientRect();
    #|     const matrix = new DOMMatrix(glyph.style.transform);
    #|     const x = parseFloat(glyph.style.width) * fraction;
    #|     const y = parseFloat(glyph.style.height) * 0.5;
    #|     return {x: page.left + parseFloat(glyph.style.left) + matrix.a*x + matrix.c*y, y: page.top + parseFloat(glyph.style.top) + matrix.b*x + matrix.d*y};
    #|   };
    #|   return {start: point(first, 0.001), end: point(last, 0.999)};
    #| })
  let positions = self.evaluate(
    expression +
    "(" +
    Json::string(first).stringify() +
    "," +
    Json::string(last).stringify() +
    ")",
  )
  guard positions
    is {
      "start": { "x": Number(x0, ..), "y": Number(y0, ..), .. },
      "end": { "x": Number(x1, ..), "y": Number(y1, ..), .. },
      ..
    } else {
    fail("Missing drag points")
  }
  ignore(
    self.command("Input.dispatchMouseEvent", params={
      "type": "mouseMoved",
      "x": x0,
      "y": y0,
    }),
  )
  @async.sleep(30)
  ignore(
    self.command("Input.dispatchMouseEvent", params={
      "type": "mousePressed",
      "x": x0,
      "y": y0,
      "button": "left",
      "buttons": 1,
      "clickCount": 1,
    }),
  )
  for step in 1..<=12 {
    let ratio = step.to_double() / 12.0
    ignore(
      self.command("Input.dispatchMouseEvent", params={
        "type": "mouseMoved",
        "x": x0 + (x1 - x0) * ratio,
        "y": y0 + (y1 - y0) * ratio,
        "button": "left",
        "buttons": 1,
      }),
    )
    @async.sleep(16)
  }
  ignore(
    self.command("Input.dispatchMouseEvent", params={
      "type": "mouseReleased",
      "x": x1,
      "y": y1,
      "button": "left",
      "buttons": 0,
      "clickCount": 1,
    }),
  )
  @async.sleep(100)
}

///|
/// Authored interaction fixture: two cropped/UserUnit pages, intrinsic rotation,
/// links, popup text and independent screen/print flags. Not a fidelity sample.
fn annotation_browser_fixture() -> Bytes {
  let annotations = [
    "<< /Subtype /Link /Rect [30 170 100 185] /Dest /chapter >>",
    "<< /Subtype /Link /Rect [30 135 100 150] /QuadPoints [30 150 100 150 30 145 100 145 30 140 60 140 30 135 60 135] /A << /S /URI /URI (https://example.com/read) >> >>",
    "<< /Subtype /Text /Rect [150 170 170 190] /T (Reviewer) /Subj (Note) /Contents (<b>Plain</b>\nSecond line) /Popup 19 0 R >>",
    "<< /Subtype /Highlight /Rect [30 185 100 205] /QuadPoints [30 205 100 205 30 185 100 185] /Contents (Body comment) >>",
    "<< /Subtype /Square /Rect [130 100 150 120] /F 4 /C [1 0 0] >>",
    "<< /Subtype /Square /Rect [160 100 180 120] /F 36 /C [0 0 1] >>",
    "<< /Subtype /Square /Rect [190 100 210 120] /F 2 >>",
    "<< /Subtype /Link /Rect [30 80 100 95] /A << /S /GoToR /D [0 /Fit] >> >>",
    "<< /Subtype /Link /Rect [30 60 100 75] /A << /S /JavaScript /JS (alert(1)) >> >>",
    "<< /Subtype /Link /Rect [30 40 100 55] /A << /S /URI /URI (javascript:alert(1)) >> >>",
    "<< /Subtype /Link /Rect [110 60 180 75] /Dest /missing >>",
    "<< /Subtype /Link /Rect [110 40 180 55] /A << /S /Named /N /NextPage >> >>",
    "<< /Subtype /Popup /Parent 9 0 R /Rect [170 170 230 220] >>",
    "<< /Subtype /Square /Rect [190 130 210 150] /F 0 /C [0 1 0] >>",
  ]
  let content = "BT /F1 12 Tf 30 190 Td (Body text) Tj ET"
  let references = [for index in 0..<annotations.length() => "\{index + 7} 0 R"].join(" ")
  let objects = [
    "<< /Type /Catalog /Pages 2 0 R /Dests << /chapter [4 0 R /XYZ 30 550 1.25] >> >>",
    "<< /Type /Pages /Count 2 /Kids [3 0 R 4 0 R] >>",
    "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 240 240] /CropBox [10 20 230 220] /Rotate 90 /UserUnit 1.5 /Contents 5 0 R /Resources << /Font << /F1 6 0 R >> >> /Annots [\{references}] >>",
    "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 350 600] /CropBox [10 20 250 580] /UserUnit 1.25 /Contents 5 0 R /Resources << /Font << /F1 6 0 R >> >> >>",
    "<< /Length \{content.length()} >>\nstream\n\{content}\nendstream",
    "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
    ..annotations,
  ]
  let output = StringBuilder()
  output.write_string("%PDF-1.7\n")
  let offsets : Array[Int] = []
  for index, object in objects {
    offsets.push(output.to_string().length())
    output.write_string("\{index + 1} 0 obj\n\{object}\nendobj\n")
  }
  let xref = output.to_string().length()
  output.write_string("xref\n0 \{objects.length() + 1}\n0000000000 65535 f \n")
  for offset in offsets {
    output.write_string(offset.to_string().pad_start(10, '0') + " 00000 n \n")
  }
  output.write_string("trailer\n<< /Size \{objects.length() + 1} /Root 1 0 R >>\nstartxref\n\{xref}\n%%EOF\n")
  @utf8.encode(output.to_string())
}

///|
async fn Browser::click_annotation(self : Browser, index : Int) -> Unit {
  let position = self.evaluate("(() => { const e = document.querySelector('.annotation-target[data-annotation-index=\"\{index}\"]'); e.scrollIntoView({block:'center'}); const r=e.getBoundingClientRect(); return {x:r.left+r.width/2, y:r.top+r.height/2}; })()")
  guard position is { "x": Number(x, ..), "y": Number(y, ..), .. } else { fail("Missing annotation point") }
  ignore(self.command("Input.dispatchMouseEvent", params={ "type": "mousePressed", "x": x, "y": y, "button": "left", "buttons": 1, "clickCount": 1 }))
  ignore(self.command("Input.dispatchMouseEvent", params={ "type": "mouseReleased", "x": x, "y": y, "button": "left", "buttons": 0, "clickCount": 1 }))
}

///|
async fn main {
  let args = @env.args()
  let base = if args.length() > 1 { args[1] } else { "http://127.0.0.1:4312" }
  let chrome = if args.length() > 2 {
    args[2]
  } else {
    "/root/.cache/ms-playwright/chromium-1223/chrome-linux/chrome"
  }
  let output = "_build/browser-test-\{@env.now()}"
  @fs.mkdir(output, recursive=true)
  @async.with_task_group(group => {
    let log = @process.redirect_to_file(output + "/chromium.log")
    defer log.close()
    let process = @process.spawn(
      group,
      chrome,
      [
        "--headless",
        "--no-sandbox",
        "--disable-gpu",
        "--disable-dev-shm-usage",
        "--remote-debugging-port=0",
        "--remote-allow-origins=*",
        "--user-data-dir=" + output + "/profile",
        "--window-size=1280,900",
        "about:blank",
      ],
      stdout=log,
      stderr=log,
    )
    defer process.cancel()
    let port_path = output + "/profile/DevToolsActivePort"
    for _ in 0..<400 {
      if @fs.exists(port_path) {
        break
      }
      @async.sleep(25)
    }
    guard @fs.exists(port_path) else { fail("Chromium did not start") }
    let port = @fs.read_file(port_path)
      .text()
      .split("\n")
      .next()
      .unwrap()
      .to_owned()
    let (response, body) = @http.put(
      "http://127.0.0.1:" + port + "/json/new?about:blank",
      b"",
    )
    guard response.code == 200 else {
      fail("Chromium failed to create a target")
    }
    let target = @json.parse(body.text())
    guard target is { "webSocketDebuggerUrl": String(url), .. } else {
      fail("Missing CDP URL")
    }
    let browser : Browser = {
      socket: @websocket.connect(url),
      browser_url: "ws://127.0.0.1:" +
        port +
        @fs.read_file(port_path).text().split("\n").to_array()[1].to_owned(),
      id: 0,
      errors: [],
      checks: [],
    }
    defer browser.socket.close()
    ignore(browser.command("Page.enable"))
    ignore(browser.command("Runtime.enable"))
    ignore(
      browser.command("Target.setAutoAttach", params={
        "autoAttach": true,
        "waitForDebuggerOnStart": false,
        "flatten": true,
      }),
    )
    ignore(
      browser.command("Emulation.setDeviceMetricsOverride", params={
        "width": 1280,
        "height": 900,
        "deviceScaleFactor": 1,
        "mobile": false,
      }),
    )
    browser.navigate(base + "/?file=/fixtures/90ms_rksj_h_sample.pdf", 1)
    browser.check(
      "predefined CMap paints and exposes native DOM text", "document.querySelector('.text-layer').textContent.includes('日本語テスト') && document.querySelector('.paint-layer').querySelector('svg') !== null && document.getElementById('error').hidden",
    )
    browser.check(
      "font fallback bridge accepts host family mappings",
      (
        #| (async () => {
        #|   const bridge = await import('./pdf-client.js');
        #|   const result = JSON.parse(await bridge.set_font_fallbacks(JSON.stringify([{pdf_name: 'Helvetica', family: 'Arial'}])));
        #|   return result.ok && result.count === 1;
        #| })()
      ),
    )
    browser.check(
      "search toolbar is enabled with document options", "!document.getElementById('search-query').disabled && document.getElementById('search-case') !== null && document.getElementById('search-whole') !== null && document.getElementById('search-diacritic') !== null",
    )
    browser.check(
      "search returns and highlights a source match",
      (
        #| (async () => {
        #|   const input = document.getElementById('search-query');
        #|   input.value = '日本語'; input.dispatchEvent(new Event('input', {bubbles: true}));
        #|   await (await import('./viewer.js')).performSearch();
        #|   return document.getElementById('search-status').textContent === '1 / 1' && document.querySelectorAll('.pdf-search-hit').length >= 1 && document.querySelector('.pdf-search-active') !== null;
        #| })()
      ),
    )
    browser.check(
      "search result navigation keeps the active match", "document.getElementById('search-next').disabled === false && document.getElementById('search-previous').disabled === false && document.getElementById('search-status').textContent === '1 / 1'",
    )
    browser.navigate(base + "/?file=/fixtures/nested_outline.pdf", 9)
    browser.check(
      "document bridge exposes outline and info",
      (
        #| (async () => {
        #|   const bridge = await import('./pdf-client.js');
        #|   const info = JSON.parse(await bridge.document_info());
        #|   return info.ok && info.outline.length > 0 && info.info.Pages === 9 && info.labels.length === 9;
        #| })()
      ),
    )
    ignore(
      browser.evaluate(
        "document.getElementById('outline-toggle').click(); true",
      ),
    )
    browser.check(
      "outline panel renders local navigation entries", "!document.getElementById('sidebar').hidden && document.getElementById('sidebar-title').textContent === '目录' && document.querySelectorAll('#sidebar-content .sidebar-item').length > 0",
    )
    browser.check(
      "outline entry navigates to its destination",
      (
        #| (() => {
        #|   const entry = [...document.querySelectorAll('#sidebar-content .sidebar-item')].find(button => !button.disabled);
        #|   if (!entry) return false;
        #|   entry.click();
        #|   return document.getElementById('page-number').value !== '';
        #| })()
      ),
    )
    ignore(
      browser.evaluate(
        "document.getElementById('thumbnail-toggle').click(); true",
      ),
    )
    browser.check(
      "thumbnail panel renders page previews",
      (
        #| (async () => {
        #|   for (let i = 0; i < 400; i++) {
        #|     if (document.querySelector('.thumbnail-preview svg')) break;
        #|     await new Promise(r => setTimeout(r, 25));
        #|   }
        #|   const count = document.querySelectorAll('.thumbnail-preview svg').length;
        #|   return document.getElementById('sidebar-title').textContent === '缩略图' && document.querySelectorAll('.thumbnail-item').length === 9 && count > 0 && count < 9;
        #| })()
      ),
    )
    browser.check(
      "thumbnail scrolling loads its destination and releases hidden previews",
      (
        #| (async () => {
        #|   const last = document.querySelector('.thumbnail-item[data-page="9"]');
        #|   last.scrollIntoView({block: 'end'});
        #|   for (let i = 0; i < 400 && !last.querySelector('svg'); i++) await new Promise(r => setTimeout(r, 25));
        #|   return Boolean(last.querySelector('svg')) && document.querySelectorAll('.thumbnail-preview svg').length < 9;
        #| })()
      ),
    )
    ignore(
      browser.evaluate("document.getElementById('info-toggle').click(); true"),
    )
    browser.check(
      "info panel exposes document fields and print control", "document.getElementById('sidebar-title').textContent === '文档信息' && document.querySelector('.info-list') !== null && document.getElementById('print').disabled === false",
    )
    browser.navigate(base + "/?file=/fixtures/labelled_pages.pdf", 11)
    browser.check(
      "page labels remain available to the browser host",
      (
        #| (async () => {
        #|   const bridge = await import('./pdf-client.js');
        #|   const info = JSON.parse(await bridge.document_info());
        #|   return info.ok && info.labels.length === 11 && info.labels[0] !== '1';
        #| })()
      ),
    )
    browser.check(
      "embedded XMP metadata can be downloaded",
      (
        #| (async () => {
        #|   const bridge = await import('./pdf-client.js');
        #|   const info = JSON.parse(await bridge.document_info());
        #|   const metadata = JSON.parse(await bridge.download_metadata());
        #|   return info.metadata.available && info.metadata.size > 0 && metadata.ok && metadata.data.length > 0;
        #| })()
      ),
    )
    ignore(
      browser.evaluate(
        "document.getElementById('view-mode').value = 'page'; document.getElementById('view-mode').dispatchEvent(new Event('change')); true",
      ),
