    ignore(
      browser.evaluate(
        "document.getElementById('zoom').value = '1'; document.getElementById('view-mode').value = 'scroll'; document.getElementById('view-mode').dispatchEvent(new Event('change')); window.hostStart = performance.now(); true",
      ),
    )
    browser.upload(cwd + "/" + pressure)
    browser.ready(200)
    let cold_open = browser.evaluate("performance.now() - hostStart")
    browser.check(
      "long document opens in a Worker without mounting off-screen pages",
      (
        #| (async () => {
        #|   const host = await import('./viewer.js');
        #|   const data = await host.runtimeDiagnostics();
        #|   return data.worker.worker && data.worker.ready && data.pages === 200 && data.mounted.length > 0 && data.mounted.length < 12 && document.querySelector('.page[data-page="150"]').dataset.rendered === 'false';
        #| })()
      ),
    )
    let memory : Array[Json] = [{ "phase": "long-document-open", "heap": browser.heap() }]
    browser.check(
      "select all copies every page while keeping off-screen DOM unloaded",
      (
        #| (async () => {
        #|   const host = await import('./viewer.js');
        #|   document.getElementById('viewer').addEventListener('pdf-selection-change', e => window.hostSelection = e.detail);
        #|   await host.selectAllText();
        #|   const data = new DataTransfer();
        #|   document.dispatchEvent(new ClipboardEvent('copy', {clipboardData: data, bubbles: true, cancelable: true}));
        #|   const text = data.getData('text/plain');
        #|   const runtime = await host.runtimeDiagnostics();
        #|   return hostSelection.ranges.length === 200 && text.includes('Host page 001') && text.includes('Host page 200') && runtime.mounted.length < 12;
        #| })()
      ),
    )
    browser.check(
      "off-screen search keeps the main thread responsive and mounts its result",
      (
        #| (async () => {
        #|   const host = await import('./viewer.js');
        #|   getSelection().removeAllRanges(); await host.readSelection();
        #|   document.getElementById('search-query').value = 'Host page 137';
        #|   const start = performance.now();
        #|   const pending = host.performSearch();
        #|   await new Promise(r => setTimeout(r, 30));
        #|   window.hostTimer = performance.now() - start;
        #|   await pending;
        #|   return hostTimer < 250 && document.getElementById('search-status').textContent === '1 / 1' && document.getElementById('page-number').value === '137' && document.querySelector('.page[data-page="137"] .pdf-search-active') !== null;
        #| })()
      ),
    )
    let cached_render = browser.evaluate(
      (
        #| (async () => {
        #|   const bridge = await import('./pdf-client.js');
        #|   const first = performance.now();
        #|   const cold = await bridge.render_page(151, 1.37, 90);
        #|   const second = performance.now();
        #|   const hot = await bridge.render_page(151, 1.37, 90);
        #|   return {cold_ms: second - first, hot_ms: performance.now() - second, identical: cold === hot, cache: JSON.parse(await bridge.cache_info())};
        #| })()
      ),
    )
    guard cached_render is { "identical": True, .. } else {
      fail("Warm render changed its output")
    }
    browser.check(
      "queued cancellation never dispatches the cancelled page",
      (
        #| (async () => {
        #|   const {pdf} = await import('./pdf-client.js');
        #|   const before = pdf.diagnostics().cancelled;
        #|   const blocker = pdf.call('render_page', [152, 1, 0]);
        #|   const controller = new AbortController();
        #|   const pending = pdf.call('render_page', [153, 1, 0], {signal: controller.signal}).catch(error => error.name);
        #|   controller.abort();
        #|   await blocker;
        #|   return await pending === 'AbortError' && pdf.diagnostics().cancelled === before + 1;
        #| })()
      ),
    )
    for number in [1, 20, 40, 60, 80, 100, 120, 160, 180, 200] {
      ignore(
        browser.evaluate(
          "document.getElementById('page-number').value = \{number}; document.getElementById('page-number').dispatchEvent(new Event('change')); true",
        ),
      )
      browser.wait(
        "document.querySelector('.page[data-page=\"\{number}\"]').dataset.rendered === 'true'",
      )
      memory.push({ "phase": "scroll-\{number}", "heap": browser.heap() })
    }
    browser.check(
      "scrolling evicts page models and render strings within both budgets",
      (
        #| (async () => {
        #|   const data = await (await import('./viewer.js')).runtimeDiagnostics();
        #|   return data.mounted.length < 12 && data.cache.pages <= data.cache.max_pages && data.cache.estimated_bytes <= data.cache.budget_bytes && data.cache.evictions > 0 && data.cache.render.entries <= data.cache.render.max_entries && data.cache.render.bytes <= data.cache.render.budget_bytes && data.cache.render.evictions > 0;
        #| })()
      ),
    )
    ignore(
      browser.evaluate(
        "for (const scale of ['2','0.75','1.25']) { document.getElementById('zoom').value = scale; document.getElementById('zoom').dispatchEvent(new Event('change')); } document.getElementById('rotate').click(); document.getElementById('rotate').click(); true",
      ),
    )
    browser.ready(200)
    browser.check(
      "rapid scale and rotation publish only the latest viewport",
      "document.getElementById('error').hidden && document.querySelector('.page[data-page=\"200\"]').style.width === '1485px' && document.querySelector('.page[data-page=\"200\"]').style.height === '1147.5px'",
    )
    browser.check(
      "print prepares all pages and releases its temporary DOM afterwards",
      (
        #| (async () => {
        #|   const host = await import('./viewer.js');
        #|   const original = window.print;
        #|   let printed = false;
        #|   let calls = 0;
        #|   window.print = () => {
        #|     calls++;
        #|     const pages = [...document.querySelectorAll('#print-pages .page')];
        #|     printed = document.body.classList.contains('pdf-print-ready') && pages.length === 200 && pages.every(page => page.querySelector('svg') && page.style.width.endsWith('pt'));
        #|   };
        #|   try { await Promise.all([host.printDocument(), host.printDocument()]); } finally { window.print = original; }
        #|   return printed && calls === 1 && !document.getElementById('print').disabled;
        #| })()
      ),
    )
    let printed = browser.command("Page.printToPDF", params={
      "preferCSSPageSize": true,
      "printBackground": true,
    })
    guard printed is { "data": String(data), .. } else {
      fail("Chromium did not generate a print PDF")
    }
    let print_bytes = @base64.decode(data)
    @fs.write_file(output + "/host-printed.pdf", print_bytes)
    let print_document = @pdflite.pdf_read_document_from_bytes(print_bytes)
    let print_pages = print_document.pages_of_pagetree()
    guard print_pages.length() == 200 else {
      fail("Printed PDF lost pages: \{print_pages.length()}")
    }
    let first_paper = print_document.parse_rectangle(print_pages[0].mediabox)
    let tenth_paper = print_document.parse_rectangle(print_pages[9].mediabox)
    guard (first_paper.max_x - first_paper.min_x - 612.0).abs() < 0.1 &&
      (first_paper.max_y - first_paper.min_y - 792.0).abs() < 0.1 &&
      (tenth_paper.max_x - tenth_paper.min_x - 1188.0).abs() < 0.1 &&
      (tenth_paper.max_y - tenth_paper.min_y - 918.0).abs() < 0.1 else {
      fail("Printed physical page dimensions changed")
    }
    ignore(browser.evaluate("window.dispatchEvent(new Event('afterprint')); true"))
    browser.check(
      "printed PDF retains all physical page sizes and temporary DOM is released",
      "!document.querySelector('#print-pages .page') && !document.body.classList.contains('pdf-print-ready')",
    )
    browser.check(
      "replacing a document terminates its running work and ignores stale results",
      (
        #| (async () => {
        #|   const host = await import('./viewer.js');
        #|   const {pdf} = await import('./pdf-client.js');
        #|   const file = new File([await (await fetch('/fixtures/90ms_rksj_h_sample.pdf')).blob()], 'replacement.pdf');
        #|   const pending = pdf.call('render_page', [180, 2, 90]).catch(error => error.name);
        #|   await host.loadFile(file, '/local/replacement.pdf');
        #|   const outcome = await pending;
        #|   const data = await host.runtimeDiagnostics();
        #|   return outcome === 'AbortError' && data.pages === 1 && document.querySelectorAll('#pages .page').length === 1 && document.querySelector('.text-layer').textContent.includes('日本語テスト') && document.getElementById('file-name').textContent === 'replacement.pdf' && document.getElementById('error').hidden;
        #| })()
      ),
    )
    browser.check(
      "Worker startup failure rejects queued work and can be recovered",
      (
        #| (async () => {
        #|   const {PdfWorkerClient} = await import('./pdf-client.js');
        #|   const client = new PdfWorkerClient({workerURL: '/missing-pdf-worker.js'});
        #|   client.reset();
        #|   const error = await client.call('cache_info').catch(error => error.code);
        #|   const released = !client.diagnostics().worker && client.diagnostics().queued === 0;
        #|   client.workerURL = new URL('./pdf-worker.js', location.href);
        #|   client.reset();
        #|   const bytes = new Uint8Array(await (await fetch('/fixtures/90ms_rksj_h_sample.pdf')).arrayBuffer());
        #|   const reopened = JSON.parse(await client.call('open_pdf', [bytes]));
        #|   client.close();
        #|   return error === 'worker-error' && released && reopened.ok && reopened.pages === 1;
        #| })()
      ),
    )
    browser.check(
      "bridge errors distinguish invalid scale rotation and missing pages",
      (
        #| (async () => {
        #|   const bridge = await import('./pdf-client.js');
        #|   const scale = JSON.parse(await bridge.render_page(1, NaN, 0));
        #|   const rotation = JSON.parse(await bridge.render_page(1, 1, 5));
        #|   const page = JSON.parse(await bridge.render_page(2, 1, 0));
        #|   return scale.code === 'invalid-scale' && rotation.code === 'invalid-rotation' && page.code === 'page-missing';
        #| })()
      ),
    )
    browser.check(
      "close releases Worker queues and page DOM and rejects later operations",
      (
        #| (async () => {
        #|   const host = await import('./viewer.js');
        #|   const {pdf} = await import('./pdf-client.js');
        #|   const pending = pdf.call('render_page', [1, 2, 90]).catch(error => error.name);
        #|   host.closeDocument();
        #|   const cancelled = await pending;
        #|   const closed = await pdf.call('document_info').catch(error => error.code);
        #|   return cancelled === 'AbortError' && closed === 'document-closed' && !pdf.diagnostics().worker && !pdf.diagnostics().queued && document.querySelectorAll('#pages .page').length === 0 && document.getElementById('download').disabled && !document.getElementById('empty-state').hidden;
        #| })()
      ),
    )
    ignore(browser.evaluate("document.getElementById('zoom').value = '1'; window.hostStart = performance.now(); true"))
    browser.upload(cwd + "/" + images)
    browser.ready(16)
    let image_open = browser.evaluate("performance.now() - hostStart")
    for number in 1..<=16 {
      let rendered = browser.evaluate(
        "(async () => { const bridge = await import('./pdf-client.js'); const page = JSON.parse(await bridge.render_page(\{number}, 1, 0)); return page.ok && page.svg.includes('<image'); })()",
      )
      guard rendered == Json::boolean(true) else {
        fail("Pressure image page \{number} was not rendered")
      }
      memory.push({ "phase": "image-\{number}", "heap": browser.heap() })
    }
    browser.check(
      "raw image pressure evicts retained assets without blanking the visible page",
      (
        #| (async () => {
        #|   const data = await (await import('./viewer.js')).runtimeDiagnostics();
        #|   return data.source_bytes > 12 * 1024 * 1024 && data.cache.estimated_bytes <= data.cache.budget_bytes && data.cache.pages <= 8 && data.cache.evictions > 0 && data.cache.render.bytes <= data.cache.render.budget_bytes && data.cache.render.entries <= 12 && data.cache.render.evictions > 0 && document.querySelector('.paint-layer image') !== null && document.getElementById('error').hidden;
        #| })()
      ),
    )
    let pressure_end = browser.evaluate("(async () => await (await import('./viewer.js')).runtimeDiagnostics())()")
    let retained = browser.heap(collect=true)
    guard browser.errors.is_empty() else {
      fail("Browser errors: " + browser.errors.to_json().stringify())
    }
    let report : Json = {
      "status": "passed",
      "checks": browser.checks,
      "passed": browser.checks.length(),
      "scope": "Browser interaction, Worker lifecycle, virtual page selection/printing and cache pressure; not pixel parity",
      "fixtures": [
        "90ms_rksj_h_sample.pdf", "vertical.pdf", "tracemonkey.pdf", "Pages-tree-refs.pdf",
      ],
      "font_loading": font_loading,
      "annotation_interactions": {
        "authored_fixture": annotations_path,
        "sha256": annotations_hash.stdout().split(" ").next().unwrap().to_owned(),
        "real_fixtures": ["annotation-link-text-popup.pdf", "annotation-text-without-popup.pdf", "widget_hidden_print.pdf"],
        "scope": "Read-only popup/link DOM, shared viewport geometry, native pointer/keyboard/selection, print intent and document cleanup; not appearance pixel parity",
      },
      "host_runtime": {
        "long_document": {
          "pages": 200,
          "source_bytes": @fs.read_file(pressure).binary().length(),
          "sha256": pressure_hash.stdout().split(" ").next().unwrap().to_owned(),
          "first_page_ms": cold_open,
          "main_thread_timer_ms": browser.evaluate("hostTimer"),
        },
        "image_document": {
          "pages": 16,
          "source_bytes": @fs.read_file(images).binary().length(),
          "sha256": image_hash.stdout().split(" ").next().unwrap().to_owned(),
          "first_page_ms": image_open,
          "samples": "Independent 512x512 raw RGB images; authored deterministic fixture",
        },
        "cold_hot_render": cached_render,
        "memory_samples": memory,
        "retained_after_gc": retained,
        "printed_pages": print_pages.length(),
        "final_runtime": pressure_end,
        "memory_scope": "CDP main/Worker JS heap samples, not continuous process peak RSS; cache bytes are estimates and exclude parsed input and temporary decoding",
      },
      "artifacts": output,
    }
    @fs.write_file(output + "/report.json", report.stringify(indent=2))
    println("Browser results: " + output + "/report.json")
    process.cancel()
    ignore(process.wait())
  })
}
