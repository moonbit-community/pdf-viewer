///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/json",
}

///|
async fn main {
  let expected = "89b500f5e1d98ed89bb90211e45b28730b2d99ac"
  let revision = @shell.Cmd("git", [
    "-C", "reference/pdf.js", "rev-parse", "HEAD",
  ]).output()
  guard revision.exit_code() == 0 && revision.stdout().trim() == expected else {
    fail("Standard 14 assets require the pinned PDF.js revision " + expected)
  }
  let source = "reference/pdf.js/external/standard_fonts"
  let files = [
    ("Times-Roman", "FoxitSerif.pfb"),
    ("Times-Bold", "FoxitSerifBold.pfb"),
    ("Times-Italic", "FoxitSerifItalic.pfb"),
    ("Times-BoldItalic", "FoxitSerifBoldItalic.pfb"),
    ("Helvetica", "LiberationSans-Regular.ttf"),
    ("Helvetica-Bold", "LiberationSans-Bold.ttf"),
    ("Helvetica-Oblique", "LiberationSans-Italic.ttf"),
    ("Helvetica-BoldOblique", "LiberationSans-BoldItalic.ttf"),
    ("Courier", "FoxitFixed.pfb"),
    ("Courier-Bold", "FoxitFixedBold.pfb"),
    ("Courier-Oblique", "FoxitFixedItalic.pfb"),
    ("Courier-BoldOblique", "FoxitFixedBoldItalic.pfb"),
    ("Symbol", "FoxitSymbol.pfb"),
    ("ZapfDingbats", "FoxitDingbats.pfb"),
  ]
  let output = StringBuilder()
  output.write_string(
    "// Generated by tools/standard14_assets.mbtx from PDF.js " +
    expected +
    ".\n" +
    "// Original font bytes are unmodified. Licenses: assets/standard14/.\n\n" +
    "///|\npub fn lookup(name : String) -> Bytes? {\n" +
    "  let encoded = match name {\n",
  )
  let inventory : Array[Json] = []
  for (name, file) in files {
    let bytes = @fs.read_file(source + "/" + file).binary()
    let hash = @shell.Cmd("shasum", ["-a", "256", source + "/" + file]).output()
    guard hash.exit_code() == 0 else { fail("cannot hash " + file) }
    inventory.push({
      "name": name,
      "file": file,
      "bytes": bytes.length(),
      "sha256": hash.stdout().split(" ").head().unwrap().to_owned(),
    })
    let encoded = @base64.encode(bytes)
    output.write_string(
      "    " + Json::string(name).stringify() + " => {\n      let value =\n",
    )
    let mut offset = 0
    while offset < encoded.length() {
      let end = (offset + 120).min(encoded.length())
      output.write_string("        #|" + encoded[offset:end].to_owned() + "\n")
      offset = end
    }
    output.write_string("      value\n    }\n")
  }
  output.write_string(
    "    _ => return None\n  }\n  Some(@base64.decode(encoded, ignore_whitespace=true)) catch { _ => None }\n}\n",
  )
  if !@fs.exists("assets/standard14") {
    @fs.mkdir("assets/standard14", recursive=true)
  }
  for license in ["LICENSE_FOXIT", "LICENSE_LIBERATION"] {
    @fs.write_file(
      "assets/standard14/" + license,
      @fs.read_file(source + "/" + license).binary(),
    )
  }
  @fs.write_file(
    "assets/standard14/inventory.json",
    Json::object({
      "reference_revision": Json::string(expected),
      "fonts": Json::array(inventory),
    }).stringify(indent=2),
  )
  @fs.write_file("internal/font_assets/assets.mbt", output.to_string())
  println(
    "Embedded \{files.length()} Standard 14 font programs from " + expected,
  )
}
