///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
/// Probe the root's pinned reader in isolated processes. Page-tree cycles,
/// unbounded font expansion and timeouts retain a per-file result instead of
/// erasing the inventory with a VM stack overflow.
async fn main {
  let args = @env.args()
  let corpus = if args.length() > 1 { args[1] } else { "reference/pdf.js/test/pdfs" }
  let prefix = if args.length() > 2 { args[2] } else { "" }
  @shell.Cmd("moon", ["build", "--target", "native", "--release", "cmd/reader_probe"]).run()
  let output = "_build/cmap-corpus-\{@env.now()}"
  @fs.mkdir(output, recursive=true)
  let failed : Array[String] = []
  let skipped : Array[String] = []
  let samples : Array[Json] = []
  let mut seen = 0
  let mut readable = 0
  let mut external = 0
  let mut dropped = 0
  let mut body = 0
  let mut dictionary = 0
  for name in @fs.readdir(corpus, sort=true) {
    if !name.has_suffix(".pdf") || !name.has_prefix(prefix) { continue }
    seen += 1
    let path = output + "/" + name + ".json"
    ignore(@shell.Cmd("_build/native/release/build/cmd/reader_probe/reader_probe.exe",
      [corpus + "/" + name, path, "--cmaps"]).output(timeout_ms=10000) catch { _ => None } noraise { value => Some(value) })
    guard @fs.exists(path) else { failed.push(name); continue }
    let result = @json.parse(@fs.read_file(path).text())
    guard result is {"passed": True, ..} else { failed.push(name); continue }
    readable += 1
    if result is {"cmap_page_tree_skipped": True, ..} { skipped.push(name) }
    if result is {"cmaps": Array(maps), ..} {
      for sample in maps {
        if sample is {"encoding": String("external"), ..} { external += 1 } else { dropped += 1 }
        if sample is {"body_usecmap": True, ..} { body += 1 }
        if sample is {"dictionary_usecmap": String(_), ..} || sample is {"dictionary_object": Number(_, ..), ..} { dictionary += 1 }
        samples.push(sample)
      }
    }
    if seen % 100 == 0 { println("CMap files checked: \{seen}") }
  }
  let report : Json = {"corpus": corpus, "prefix": prefix, "files_seen": seen,
    "documents_read": readable, "documents_failed": failed.length(), "failed_files": failed,
    "page_tree_skipped": skipped, "external_cmaps": external, "reader_dropped_cmaps": dropped,
    "body_usecmap": body, "dictionary_usecmap": dictionary, "samples": samples}
  @fs.write_file(output + "/report.json", report.stringify(indent=2))
  println(report.stringify(indent=2))
  println("CMap corpus: " + output + "/report.json")
}
