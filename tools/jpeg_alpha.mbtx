///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
}

///|
/// Exact source-image acceptance for a page with one XObject RGBA image.
/// Usage: moon run tools/jpeg_alpha.mbtx input.pdf output-dir node_modules-dir
/// node_modules must contain the pinned pdfjs-dist, @napi-rs/canvas and resvg
/// oracle dependencies. This tool never installs them or changes the viewer.
async fn main {
  let args = @env.args()
  guard args.length() == 4 else {
    fail("usage: jpeg_alpha.mbtx input.pdf output-dir node_modules-dir")
  }
  let directory = args[2]
  if !@fs.exists(directory) {
    @fs.mkdir(directory, recursive=true)
  }
  @fs.write_file(directory + "/fixture.pdf", @fs.read_file(args[1]).binary())
  @shell.Cmd("moon", ["build", "--target", "js", "--release", "cmd/browser"]).run()
  @fs.write_file(
    directory + "/viewer.mjs",
    @fs.read_file("_build/js/release/build/cmd/browser/browser.js").binary(),
  )
  @fs.write_file(directory + "/measure.mjs", script())
  @shell.Cmd("node", [directory + "/measure.mjs", args[3]]).run()
}

