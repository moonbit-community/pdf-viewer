///|
import {
  "moonbitlang/x@0.5.5/fs",
  "moonbitlang/core/encoding/base64",
}

///|
/// Test-only bytes keep the same real Adobe fixtures available on all four
/// backends. Runtime assets remain the existing PDF.js binary CMaps.
fn main raise {
  let output = StringBuilder()
  output.write_string(
    "// Generated by tools/cmap_test_assets.mbtx; test-only, unmodified Adobe sources.\n// Source, revision, SHA-256 and license: assets/cmaps/test-sources/.\n///|\nfn cmap_real_test_source(name : String) -> String raise {\n  let encoded = match name {\n",
  )
  for name in ["90ms-RKSJ-H", "90ms-RKSJ-V", "UniJIS-UTF32-H", "UniJIS-UTF32-V"] {
    let data = @fs.read_file_to_bytes("assets/cmaps/test-sources/" + name)
    let encoded = @base64.encode(data)
    output.write_string("    \"" + name + "\" =>\n")
    let mut index = 0
    while index < encoded.length() {
      let end = if index + 96 < encoded.length() {
        index + 96
      } else {
        encoded.length()
      }
      output.write_string("      \"" + encoded[index:end].to_owned() + "\"")
      output.write_string(if end == encoded.length() { "\n" } else { " +\n" })
      index = end
    }
  }
  output.write_string(
    "    _ => fail(\"unknown real CMap fixture\")\n  }\n  @utf8.decode(@base64.decode(encoded))\n}\n",
  )
  @fs.write_string_to_file("cmap_real_assets_wbtest.mbt", output.to_string())
}
