///|
async fn measure(
  browser : Browser,
  file : String,
  page : Int,
  rotation : Int,
  scale : Double,
  counts : Json,
  features : Json,
  hash : String,
  output : String,
  diagnostic_translation : Double,
) -> Json {
  let stem = file + ".page-\{page}.rotation-\{rotation}"
  let reference_stem = output + "/" + stem + ".reference"
  let viewer_stem = output + "/" + stem + ".viewer"
  let diff_stem = output + "/" + stem + ".diff"
  let args = "(\{page},\{scale},\{rotation})"
  let reference = browser.evaluate("window.renderReference" + args)
  @fs.write_file(reference_stem + ".json", reference.stringify(indent=2))
  let rw = integer(field(reference, "width"))
  let rh = integer(field(reference, "height"))
  browser.capture(reference_stem, rw, rh)
  let viewer = browser.evaluate(
    "window.renderViewer(\{page},\{scale},\{rotation},\{diagnostic_translation})",
  )
  @fs.write_file(viewer_stem + ".json", viewer.stringify(indent=2))
  let vw = integer(field(viewer, "width"))
  let vh = integer(field(viewer, "height"))
  browser.capture(viewer_stem, vw, vh)
  let result = @shell.Cmd(
    "_build/native/release/build/cmd/visual_diff/visual_diff.exe",
    [
      reference_stem + ".rgba",
      rw.to_string(),
      rh.to_string(),
      viewer_stem + ".rgba",
      vw.to_string(),
      vh.to_string(),
      diff_stem + ".rgba",
    ],
  ).output(timeout_ms=30000)
  guard result.exit_code() == 0 else {
    fail("Pixel comparison failed: " + result.stdout() + result.stderr())
  }
  let pixels = @json.parse(result.stdout())
  browser.heatmap(
    diff_stem,
    integer(field(pixels, "width")),
    integer(field(pixels, "height")),
  )
  let geometry = geometry_comparison(reference, viewer)
  let text = text_comparison(reference, viewer)
  let difference = integer(field(pixels, "changed_above_tolerance")) > 0 ||
    field(geometry, "equal_within_1e_6") != Json::boolean(true) ||
    field(text, "without_whitespace_equal") != Json::boolean(true) ||
    field(counts, "referencePages") != field(counts, "viewerPages")
  {
    "file": file,
    "file_sha256": hash,
    "page": page,
    "rotation": rotation,
    "scale": scale,
    "diagnostic_viewer_translation_x": diagnostic_translation,
    "features": features,
    "page_counts": counts,
    "status": if difference {
      "measured-with-differences"
    } else {
      "measured-within-tolerance"
    },
    "pixels": pixels,
    "geometry": geometry,
    "text": text,
    "reference_render_ms": field(reference, "render_ms"),
    "viewer_render_ms": field(viewer, "render_ms"),
    "placeholders": field(viewer, "placeholders"),
    "reference_png": stem + ".reference.png",
    "viewer_png": stem + ".viewer.png",
    "diff_png": stem + ".diff.png",
    "reference_json": stem + ".reference.json",
    "viewer_json": stem + ".viewer.json",
  }
}

///|
fn escape_html(value : String) -> String {
  value
  .replace(old="&", new="&amp;")
  .replace(old="<", new="&lt;")
  .replace(old=">", new="&gt;")
  .replace(old="\"", new="&quot;")
  .replace(old="'", new="&#39;")
}

///|
fn html_report(results : Array[Json]) -> String {
  let html = StringBuilder()
  let intro =
    #| <!doctype html><meta charset="utf-8"><title>MoonBit / PDF.js comparison</title>
    #| <style>body{font:15px system-ui;margin:32px;background:#f5f6f8;color:#182235}article{background:white;padding:20px;margin:24px 0;border-radius:8px}.pages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}img{display:block;max-width:100%;border:1px solid #ccd2da}pre{white-space:pre-wrap}a{color:#1854b3}</style>
    #| <h1>MoonBit / PDF.js comparison</h1><p>Same browser, white background, scale and device-pixel coordinates. Yellow: matching colors within a symmetric 1px neighborhood; red: outside that neighborhood. Yellow can still mean a shifted thin line. Raw differences remain counted. This selected corpus is not a compatibility percentage.</p><p><a href="report.json">Full JSON report</a></p>
  html.write_string(intro)
  for result in results {
    html.write_string("<article><h2>")
    html.write_string(escape_html(field(result, "file").stringify()))
    html.write_string(
      " · page " +
      field(result, "page").stringify() +
      " · rotation " +
      field(result, "rotation").stringify() +
      "</h2>",
    )
    if field(result, "status") == Json::string("failed") {
      html.write_string(
        "<pre>" + escape_html(result.stringify(indent=2)) + "</pre></article>",
      )
      continue
    }
    let pixels = field(result, "pixels")
    html.write_string(
      "<p>" +
      escape_html(field(result, "status").stringify()) +
      " · raw pixels above tolerance: " +
      field(pixels, "changed_above_tolerance").stringify() +
      " · outside neighborhood: " +
      field(pixels, "outside_neighborhood").stringify() +
      "</p><div class=pages>",
    )
    for
      (name, key) in [
        ("PDF.js", "reference_png"),
        ("MoonBit", "viewer_png"),
        ("Differences", "diff_png"),
      ] {
      guard field(result, key) is String(path) else { continue }
      html.write_string(
        "<div>" +
        name +
        "<a href=\"" +
        escape_html(path) +
        "\"><img loading=lazy src=\"" +
        escape_html(path) +
        "\"></a></div>",
      )
    }
    html.write_string(
      "</div><details><summary>Text / viewport / pixel metrics</summary><pre>" +
      escape_html(result.stringify(indent=2)) +
      "</pre></details></article>",
    )
  }
  html.to_string()
}

///|
async fn main {
  let args = @env.args()
  if args.length() > 4 {
    fail("usage: visual_test.mbtx [manifest.json] [chromium] [--strict]")
  }
  let manifest_path = if args.length() > 1 {
    args[1]
  } else {
    "tools/visual_cases.json"
  }
  let chrome = if args.length() > 2 {
    args[2]
  } else {
    "/root/.cache/ms-playwright/chromium-1223/chrome-linux/chrome"
  }
  let strict = args.length() > 3 && args[3] == "--strict"
  if args.length() > 3 && !strict {
    fail("Unknown argument: " + args[3])
  }
  let manifest = @json.parse(@fs.read_file(manifest_path).text())
  guard field(manifest, "reference_revision") is String(revision) &&
    revision.length() == 40 else {
    fail("Manifest requires a full reference revision")
  }
  guard field(manifest, "cases") is Array(cases) && !cases.is_empty() else {
    fail("Manifest requires selected cases")
  }
  let scale = number(field(manifest, "scale"))
  guard !scale.is_nan() && !scale.is_inf() && scale > 0.0 && scale <= 8.0 else {
    fail("Invalid render scale")
  }
  let ref_revision = @shell.Cmd("git", [
    "-C", "reference/pdf.js", "rev-parse", "HEAD",
  ]).output()
  guard ref_revision.exit_code() == 0 &&
    ref_revision.stdout().trim() == revision else {
    fail("PDF.js checkout does not match the manifest revision")
  }
  let ref_dirty = @shell.Cmd("git", [
    "-C", "reference/pdf.js", "diff", "--name-only", "HEAD", "src", "external", "gulpfile.mjs",
    "package.json", "package-lock.json",
  ]).output()
  guard ref_dirty.exit_code() == 0 && ref_dirty.stdout().trim().is_empty() else {
    fail("PDF.js reference sources have uncommitted changes")
  }
  let version_info = @json.parse(
    @fs.read_file("reference/pdf.js/build/version.json").text(),
  )
  guard field(version_info, "commit") is String(short_revision) &&
    revision.has_prefix(short_revision) &&
    short_revision.length() >= 7 else {
    fail(
      "Build PDF.js at the pinned revision with `npx gulp generic` before measuring",
    )
  }
  @shell.Cmd("moon", ["run", "tools/build_web.mbtx"]).run()
  @shell.Cmd("moon", [
    "build", "--target", "native", "--release", "cmd/visual_diff",
  ]).run()
  let output = "_build/visual-test-\{@env.now()}"
  @fs.mkdir(output, recursive=true)
  @fs.write_file(output + "/manifest.json", manifest.stringify(indent=2))
  let font_list = @shell.Cmd("fc-list", []).output()
  @fs.write_file(output + "/host-fonts.txt", font_list.stdout())
  let viewer_revision = @shell.Cmd("git", ["rev-parse", "HEAD"]).output()
  let viewer_dirty = @shell.Cmd("git", ["status", "--porcelain"]).output()
  let results : Array[Json] = []
  let errors : Array[Json] = []
  let warnings : Array[Json] = []
  let mut runtime : Json = Json::null()
  @async.with_task_group(group => {
    let server = @http.Server(@socket.Addr::parse("127.0.0.1:0"))
    defer server.close()
    group.spawn_bg(
      () => server.run_forever((request, _, conn) => serve(request, conn)),
      no_wait=true,
    )
    let base = "http://" + server.addr.to_string()
    let log = @process.redirect_to_file(output + "/chromium.log")
    defer log.close()
    let process = @process.spawn(
      group,
      chrome,
      [
        "--headless",
        "--no-sandbox",
        "--disable-gpu",
        "--disable-dev-shm-usage",
        "--remote-debugging-port=0",
        "--remote-allow-origins=*",
        "--user-data-dir=" + output + "/profile",
        "--window-size=1280,900",
        "about:blank",
      ],
      stdout=log,
      stderr=log,
    )
    defer process.cancel()
    let port_path = output + "/profile/DevToolsActivePort"
    for _ in 0..<400 {
      if @fs.exists(port_path) {
        break
      }
      @async.sleep(25)
    }
    guard @fs.exists(port_path) else {
      fail("Chromium did not start; see " + output + "/chromium.log")
    }
    let port = @fs.read_file(port_path)
      .text()
      .split("\n")
      .next()
      .unwrap()
      .to_owned()
    let (response, body) = @http.put(
      "http://127.0.0.1:" + port + "/json/new?about:blank",
      b"",
    )
    guard response.code == 200 else {
      fail("Chromium failed to create a target")
    }
    guard @json.parse(body.text())
      is { "webSocketDebuggerUrl": String(url), .. } else {
      fail("Missing CDP URL")
    }
    let browser : Browser = {
      socket: @websocket.connect(url),
      id: 0,
      errors,
      warnings,
    }
    defer browser.socket.close()
    ignore(browser.command("Page.enable"))
    ignore(browser.command("Runtime.enable"))
    ignore(
      browser.command("Emulation.setDeviceMetricsOverride", params={
        "width": 1280,
        "height": 900,
        "deviceScaleFactor": 1,
        "mobile": false,
      }),
    )
    ignore(browser.command("Page.navigate", params={ "url": base + "/" }))
    for _ in 0..<400 {
      if browser.evaluate(
          "document.readyState === 'complete' && location.href === " +
          Json::string(base + "/").stringify(),
        ) ==
        Json::boolean(true) {
        break
      }
      @async.sleep(25)
    }
    runtime = browser.evaluate(browser_bridge)
    guard field(runtime, "build") is String(build) &&
      build.length() >= 7 &&
      revision.has_prefix(build) else {
      fail("Loaded PDF.js does not match the manifest revision")
    }
    for fixture in cases {
      guard field(fixture, "file") is String(file) &&
        valid_filename(file) &&
        file.has_suffix(".pdf") else {
        fail("Invalid fixture filename")
      }
      guard field(fixture, "pages") is Array(pages) &&
        !pages.is_empty() &&
        field(fixture, "rotations") is Array(rotations) &&
        !rotations.is_empty() else {
        fail("Fixture requires pages and rotations")
      }
      let features = field(fixture, "features")
      let diagnostic_translation = match
        field(fixture, "diagnostic_viewer_translation_x") {
        Null => 0.0
        Number(value, ..) if !value.is_nan() &&
          !value.is_inf() &&
          value.abs() <= 16.0 => value
        _ => fail("Invalid diagnostic viewer translation")
      }
      let hash_output = @shell.Cmd("sha256sum", [
        "reference/pdf.js/test/pdfs/" + file,
      ]).output()
      let hash = if hash_output.exit_code() == 0 {
        hash_output.stdout().split(" ").next().unwrap().to_owned()
      } else {
        "unavailable"
      }
      let pair = browser.evaluate(
        "window.openPair(" + Json::string(file).stringify() + ")",
      ) catch {
        error => Json::object({ "error": @debug.to_string(error) })
      }
      for page_value in pages {
        let page = integer(page_value)
        guard page > 0 else { fail("Page numbers must be positive") }
        for rotation_value in rotations {
          let rotation = integer(rotation_value)
          guard rotation % 90 == 0 else {
            fail("Rotation must be a multiple of 90")
          }
          let result = try {
            if field(pair, "error") is String(message) {
              fail("Document open failed: " + message)
            }
            measure(
              browser, file, page, rotation, scale, pair, features, hash, output,
              diagnostic_translation,
            )
          } catch {
            error =>
              Json::object({
                "file": file,
                "file_sha256": hash,
                "page": page,
                "rotation": rotation,
                "scale": scale,
                "features": features,
                "status": "failed",
                "error": @debug.to_string(error),
              })
          }
          results.push(result)
          @fs.write_file(
            output + "/partial-results.json",
            Json::array(results).stringify(indent=2),
          )
          if field(result, "status") == Json::string("failed") {
            println(
              "FAILED: \{file} page \{page} rotation \{rotation}: " +
              field(result, "error").stringify(),
            )
          } else {
            let pixels = field(result, "pixels")
            println(
              "MEASURED: \{file} page \{page} rotation \{rotation}: " +
              field(pixels, "changed_above_tolerance").stringify() +
              " raw changed pixels; " +
              field(pixels, "outside_neighborhood").stringify() +
              " outside 1px neighborhood",
            )
          }
        }
      }
    }
    ignore(
      browser.evaluate(
        "(async () => { if (window.referenceTask) await referenceTask.destroy(); moon.close_pdf(); return true; })()",
      ) catch {
        error => {
          errors.push({ "cleanup_error": @debug.to_string(error) })
          Json::null()
        }
      },
    )
    group.return_immediately(())
  })
  let failed = results
    .filter(r => field(r, "status") == Json::string("failed"))
    .length()
  let different = results
    .filter(r => field(r, "status") == Json::string("measured-with-differences"))
    .length()
  let report : Json = {
    "status": if failed > 0 || !errors.is_empty() {
      "measurement-failed"
    } else if different > 0 {
      "measured-with-differences"
    } else {
      "measured-within-tolerance"
    },
    "scope": "All manifest-selected pages/rotations; not the full PDF.js corpus or a compatibility percentage",
    "reference_revision": revision,
    "reference_runtime": runtime,
    "viewer_revision": viewer_revision.stdout().trim().to_owned(),
    "viewer_worktree": viewer_dirty.stdout(),
    "scale": scale,
    "device_scale_factor": 1,
    "background": "white",
    "reference_options": {
      "annotation_mode": "ENABLE",
      "use_system_fonts": true,
      "disable_font_face": false,
      "enable_xfa": false,
    },
    "pixel_policy": {
      "channel_tolerance": 8,
      "ink_tolerance": 24,
      "neighborhood_radius": 1,
      "neighborhood_is_diagnostic_only": true,
    },
    "host_fonts": "host-fonts.txt",
    "strict": strict,
    "total": results.length(),
    "measured": results.length() - failed,
    "failed": failed,
    "with_differences": different,
    "runtime_exceptions": errors,
    "console_warnings": warnings,
    "results": results,
  }
  @fs.write_file(output + "/report.json", report.stringify(indent=2))
  @fs.write_file(output + "/index.html", html_report(results))
  println("Visual report: " + output + "/index.html")
  println(
    "Measured \{results.length() - failed}/\{results.length()}; \{different} with differences; \{failed} failed",
  )
  if failed > 0 || !errors.is_empty() {
    fail("Visual measurement failed; inspect " + output + "/report.json")
  }
  if strict && different > 0 {
    fail(
      "Strict comparison rejected known visual/text/viewport differences; inspect the report",
    )
  }
}
