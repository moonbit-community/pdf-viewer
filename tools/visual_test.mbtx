///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/http",
  "moonbitlang/async/process",
  "moonbitlang/async/shell",
  "moonbitlang/async/socket",
  "moonbitlang/async/websocket",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/base64",
}

///|
struct Browser {
  socket : @websocket.Conn
  mut id : Int
  errors : Array[Json]
  warnings : Array[Json]
}

///|
async fn Browser::command(
  self : Browser,
  operation : String,
  params? : Json = {},
) -> Json {
  self.id += 1
  let id = self.id
  let request : Json = { "id": id, "method": operation, "params": params }
  self.socket.send_text(request.stringify())
  for ;; {
    let message = @async.with_timeout(45000, () => {
      self.socket.recv().read_all().text()
    })
    let response = @json.parse(message)
    match response {
      { "id": Number(value, ..), "error": error, .. } if value == id.to_double() =>
        fail("CDP error: " + error.stringify())
      { "id": Number(value, ..), "result": result, .. } if value ==
        id.to_double() => return result
      { "method": String("Runtime.exceptionThrown"), .. } =>
        self.errors.push(response)
      {
        "method": String("Runtime.consoleAPICalled"),
        "params": { "type": String(kind), .. },
        ..
      } if kind == "warning" || kind == "error" => self.warnings.push(response)
      _ => ()
    }
  }
}

///|
async fn Browser::evaluate(self : Browser, expression : String) -> Json {
  let response = self.command("Runtime.evaluate", params={
    "expression": expression,
    "awaitPromise": true,
    "returnByValue": true,
  })
  match response {
    {
      "exceptionDetails": {
        "exception": { "description": String(message), .. },
        ..
      },
      ..
    } => fail("Browser evaluation: " + message)
    { "exceptionDetails": error, .. } =>
      fail("Browser evaluation: " + error.stringify())
    { "result": { "value": value, .. }, .. } => value
    _ => fail("Missing browser result: " + response.stringify())
  }
}

///|
async fn Browser::capture(
  self : Browser,
  stem : String,
  width : Int,
  height : Int,
) -> Unit {
  guard width > 0 &&
    height > 0 &&
    width <= 8192 &&
    height <= 8192 &&
    width <= 16777216 / height else {
    fail("Raster exceeds the validation limit (16M pixels / 8192px per side)")
  }
  let response = self.command("Page.captureScreenshot", params={
    "format": "png",
    "fromSurface": true,
    "captureBeyondViewport": true,
    "clip": { "x": 0, "y": 0, "width": width, "height": height, "scale": 1 },
  })
  guard response is { "data": String(png), .. } else {
    fail("Missing screenshot")
  }
  @fs.write_file(stem + ".png", @base64.decode(png))
  // Browser code here only decodes its own PNG and copies the RGBA bytes.
  // Pixel analysis, accounting, file IO and process control remain MoonBit.
  let raw = self.evaluate(
    "window.decodeScreenshot(" + Json::string(png).stringify() + ")",
  )
  guard raw
    is {
      "rgba": String(rgba),
      "width": Number(w, ..),
      "height": Number(h, ..),
      ..
    } &&
    w == width.to_double() &&
    h == height.to_double() else {
    fail("Screenshot dimensions differ from the requested device-pixel clip")
  }
  @fs.write_file(stem + ".rgba", @base64.decode(rgba))
}

///|
async fn Browser::heatmap(
  self : Browser,
  stem : String,
  width : Int,
  height : Int,
) -> Unit {
  let bytes = @fs.read_file(stem + ".rgba").binary()
  let encoded = @base64.encode(bytes)
  let response = self.evaluate(
    "window.encodeHeatmap(" +
    Json::string(encoded).stringify() +
    ",\{width},\{height})",
  )
  guard response is String(png) else { fail("Missing encoded heatmap") }
  @fs.write_file(stem + ".png", @base64.decode(png))
}

///|
fn field(value : Json, name : String) -> Json {
  match value {
    Object(fields) => fields.get(name).unwrap_or(Json::null())
    _ => Json::null()
  }
}

///|
fn integer(value : Json) -> Int {
  guard value is Number(number, ..) &&
    !number.is_nan() &&
    !number.is_inf() &&
    number == number.trunc() &&
    number >= -2147483648.0 &&
    number <= 2147483647.0 else {
    abort("Expected a finite Int: " + value.stringify())
  }
  number.to_int()
}

///|
fn number(value : Json) -> Double {
  guard value is Number(number, ..) else { abort("Expected a number") }
  number
}

///|
fn without_whitespace(text : String) -> String {
  let output = StringBuilder()
  for character in text {
    if !character.is_whitespace() {
      output.write_char(character)
    }
  }
  output.to_string()
}

///|
fn text_comparison(reference : Json, viewer : Json) -> Json {
  guard field(reference, "text") is String(a) &&
    field(viewer, "text") is String(b) else {
    return { "error": "Missing text output" }
  }
  let normalized_a = without_whitespace(a)
  let normalized_b = without_whitespace(b)
  let limit = if normalized_a.length() < normalized_b.length() {
    normalized_a.length()
  } else {
    normalized_b.length()
  }
  let mut first_difference = 0
  while first_difference < limit &&
        normalized_a[first_difference] == normalized_b[first_difference] {
    first_difference += 1
  }
  {
    "raw_equal": a == b,
    "without_whitespace_equal": normalized_a == normalized_b,
    "reference_utf16_units": a.length(),
    "viewer_utf16_units": b.length(),
    "reference_nonspace_utf16_units": normalized_a.length(),
    "viewer_nonspace_utf16_units": normalized_b.length(),
    "first_nonspace_difference_utf16": if normalized_a == normalized_b {
      Json::null()
    } else {
      Json::number(first_difference.to_double())
    },
    "scope": "Paint-order text with whitespace removed; no bidi/ligature normalization or glyph/run correspondence is inferred",
  }
}

///|
fn geometry_comparison(reference : Json, viewer : Json) -> Json {
  let a = field(reference, "viewport")
  let b = field(viewer, "viewport")
  let width_delta = (number(field(a, "width")) - number(field(b, "width"))).abs()
  let height_delta = (number(field(a, "height")) - number(field(b, "height"))).abs()
  guard field(a, "matrix") is Array(am) &&
    field(b, "matrix") is Array(bm) &&
    am.length() == 6 &&
    bm.length() == 6 else {
    return { "error": "Invalid viewport matrix" }
  }
  let mut matrix_delta = 0.0
  for index in 0..<6 {
    let delta = (number(am[index]) - number(bm[index])).abs()
    if delta > matrix_delta {
      matrix_delta = delta
    }
  }
  {
    "equal_within_1e_6": width_delta <= 0.000001 &&
    height_delta <= 0.000001 &&
    matrix_delta <= 0.000001,
    "width_delta": width_delta,
    "height_delta": height_delta,
    "max_matrix_delta": matrix_delta,
    "reference": a,
    "viewer": b,
    "scope": "Viewport dimensions and affine transform; raw per-run/glyph geometry is retained separately",
  }
}

///|
async fn serve(request : @http.Request, conn : @http.ServerConnection) -> Unit {
  let path = request.path
  if !(request.meth is (Get | Head)) {
    conn.send_response(405, "Method Not Allowed")
    conn.end_response()
    return
  }
  if path == "/" {
    let html = "<!doctype html><meta charset=utf-8><title>PDF comparison</title><style>html,body{margin:0;background:white}svg,canvas{display:block}</style>"
    conn.send_response(200, "OK", extra_headers={
      "Content-Type": "text/html; charset=utf-8",
    })
    if request.meth is Get {
      conn.write(html)
    }
    conn.end_response()
    return
  }
  let file = match path {
    "/_moon/pdf.js" => Some("web/_generated/pdf.js")
    [.. "/fixture/", .. name] if valid_filename(name.to_owned()) &&
      name.has_suffix(".pdf") =>
      Some("reference/pdf.js/test/pdfs/" + name.to_owned())
    [.. "/_oracle/build/", .. name] if name == "pdf.mjs" ||
      name == "pdf.worker.mjs" ||
      name == "pdf.renderer.mjs" =>
      Some("reference/pdf.js/build/generic/build/" + name.to_owned())
    [.. "/_oracle/web/", .. rest] => {
      let parts = rest.split("/").to_array()
      if parts.length() == 2 &&
        (
          parts[0] == "cmaps" ||
          parts[0] == "standard_fonts" ||
          parts[0] == "wasm" ||
          parts[0] == "iccs"
        ) &&
        valid_filename(parts[1].to_owned()) {
        Some("reference/pdf.js/build/generic/web/" + rest.to_owned())
      } else {
        None
      }
    }
    _ => None
  }
  guard file is Some(file) && @fs.exists(file) else {
    conn.send_response(404, "Not Found")
    conn.end_response()
    return
  }
  let mime = if file.has_suffix(".mjs") || file.has_suffix(".js") {
    "text/javascript; charset=utf-8"
  } else if file.has_suffix(".wasm") {
    "application/wasm"
  } else {
    "application/octet-stream"
  }
  let bytes = @fs.read_file(file).binary()
  conn.send_response(200, "OK", extra_headers={
    "Content-Type": mime,
    "Content-Length": bytes.length().to_string(),
    "Cache-Control": "no-store",
  })
  if request.meth is Get {
    conn.write(bytes)
  }
  conn.end_response()
}

///|
fn valid_filename(name : String) -> Bool {
  if name.is_empty() || name.contains("..") {
    return false
  }
  for character in name {
    if !((character >= 'a' && character <= 'z') ||
      (character >= 'A' && character <= 'Z') ||
      (character >= '0' && character <= '9') ||
      character == '.' ||
      character == '_' ||
      character == '-') {
      return false
    }
  }
  true
}

