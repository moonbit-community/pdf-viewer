///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
}

///|
/// Test-only inclusive image/page stage timing. No product logging is added.
/// Usage: moon run tools/image_stages.mbtx input.pdf output-directory
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail("usage: image_stages.mbtx input.pdf output-directory")
  }
  let directory = args[2]
  if !@fs.exists(directory) {
    @fs.mkdir(directory, recursive=true)
  }
  @fs.write_file(directory + "/fixture.pdf", @fs.read_file(args[1]).binary())
  @shell.Cmd("moon", ["build", "--target", "js", "--release", "cmd/browser"]).run()
  @fs.write_file(
    directory + "/viewer.mjs",
    @fs.read_file("_build/js/release/build/cmd/browser/browser.js").binary(),
  )
  @fs.write_file(directory + "/measure.mjs", script())
  @shell.Cmd("node", [directory + "/measure.mjs"]).run()
}

