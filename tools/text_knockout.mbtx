///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

///|
struct TextKnockoutCase {
  name : String
  content : String
} derive(ToJson)

///|
fn cases() -> Array[TextKnockoutCase] {
  let overlap = "BT /F1 100 Tf 1 0 0 1 30 35 Tm .1 .2 .8 rg (B) Tj 1 0 0 1 30 35 Tm .8 .2 .1 rg (B) Tj ET"
  [
    { name: "default-TK-true", content: "/Half gs " + overlap, },
    { name: "explicit-TK-false", content: "/Off gs /Half gs " + overlap, },
    {
      name: "separate-BT-objects",
      content: "/Half gs BT /F1 100 Tf 1 0 0 1 30 35 Tm .1 .2 .8 rg (B) Tj ET BT /F1 100 Tf 1 0 0 1 30 35 Tm .8 .2 .1 rg (B) Tj ET",
    },
    { name: "two-Form-invocations", content: "/Fm Do /Fm Do", },
    {
      name: "inherited-alpha-and-blend",
      content: ".3 .6 .9 rg 0 0 240 160 re f /Blend gs " +
      overlap +
      " 150 35 40 74 re f",
    },
    { name: "inherited-soft-mask-once", content: "/Mask gs " + overlap, },
  ]
}

///|
fn stream(dictionary : String, content : String) -> String {
  "<< /Length \{content.length()} \{dictionary} >>\nstream\n\{content}\nendstream"
}

///|
fn fixture_pdf(font : Bytes, samples : Array[TextKnockoutCase]) -> Bytes {
  let font_id = 3 + samples.length() * 2
  let kids = [ for i in 0..<samples.length() => "\{3 + i * 2} 0 R" ].join(" ")
  let objects = [
    "<< /Type /Catalog /Pages 2 0 R >>",
    "<< /Type /Pages /Count \{samples.length()} /Kids [\{kids}] >>",
  ]
  for i, sample in samples {
    objects.push(
      "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 240 160] /Contents \{4 + i * 2} 0 R /Resources << /Font << /F1 \{font_id} 0 R >> /XObject << /Fm \{font_id + 4} 0 R >> /ExtGState << /Half << /ca .5 >> /Off << /TK false >> /Blend << /ca .5 /BM /Multiply >> /Mask << /ca .5 /SMask << /S /Alpha /G \{font_id + 3} 0 R >> >> >> >> >>",
    )
    objects.push(stream("", sample.content))
  }
  objects.push(
    "<< /Type /Font /Subtype /TrueType /BaseFont /AffinePenFixture-Regular /FirstChar 65 /LastChar 66 /Widths [650 650] /Encoding /WinAnsiEncoding /FontDescriptor \{font_id + 1} 0 R >>",
  )
  objects.push(
    "<< /Type /FontDescriptor /FontName /AffinePenFixture-Regular /Flags 32 /FontBBox [0 0 680 740] /Ascent 800 /Descent -200 /CapHeight 740 /ItalicAngle 0 /StemV 80 /FontFile2 \{font_id + 2} 0 R >>",
  )
  let hex = StringBuilder()
  for byte in font {
    hex.write_string(byte.to_int().to_string(radix=16).pad_start(2, '0'))
  }
  hex.write_char('>')
  objects.push(
    stream("/Length1 \{font.length()} /Filter /ASCIIHexDecode", hex.to_string()),
  )
  objects.push(
    stream(
      "/Type /XObject /Subtype /Form /BBox [0 0 240 160] /Group << /S /Transparency /I true >> /Resources << /ExtGState << /A << /ca .5 >> >> >>",
      "/A gs 0 g 0 0 240 160 re f",
    ),
  )
  objects.push(
    stream(
      "/Type /XObject /Subtype /Form /BBox [0 0 240 160] /Resources << /Font << /F1 \{font_id} 0 R >> /ExtGState << /Half << /ca .5 >> >> >>",
      "/Half gs BT /F1 100 Tf 1 0 0 1 30 35 Tm .1 .2 .8 rg (B) Tj 1 0 0 1 30 35 Tm .8 .2 .1 rg (B) Tj ET",
    ),
  )
  let output = StringBuilder()
  output.write_string("%PDF-1.7\n")
  let offsets : Array[Int] = []
  for i, object in objects {
    offsets.push(output.to_string().length())
    output.write_string("\{i + 1} 0 obj\n\{object}\nendobj\n")
  }
  let xref = output.to_string().length()
  output.write_string("xref\n0 \{objects.length() + 1}\n0000000000 65535 f \n")
  for offset in offsets {
    output.write_string(offset.to_string().pad_start(10, '0') + " 00000 n \n")
  }
  output.write_string(
    "trailer\n<< /Size \{objects.length() + 1} /Root 1 0 R >>\nstartxref\n\{xref}\n%%EOF\n",
  )
  @utf8.encode(output.to_string())
}

///|
/// Run from the repository root: moon run tools/text_knockout.mbtx [directory]
async fn main {
  let args = @env.args()
  let directory = if args.length() > 2 {
    args[2]
  } else {
    "_build/text-knockout"
  }
  if !@fs.exists(directory) {
    @fs.mkdir(directory, recursive=true)
  }
  let font = @fs.read_file("tools/fixtures/text-stroke/affine-pen.ttf").binary()
  @fs.write_file(directory + "/text-knockout.pdf", fixture_pdf(font, cases()))
  let manifest : Json = {
    "license": "Apache-2.0",
    "font": "Original two-glyph TrueType fixture; see tools/fixtures/text-stroke/README.md",
    "cases": cases(),
  }
  @fs.write_file(directory + "/manifest.json", manifest.stringify(indent=2))
  println(directory)
}
