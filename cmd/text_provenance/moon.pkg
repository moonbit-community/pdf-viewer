import {
  "moonbit-community/pdf-viewer" @pdf,
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "-lstdc++" } },
)
