import {
  "moonbit-community/pdf-viewer" @pdf,
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/pdflite/core",
}

supported_targets = "js"

options(
  link: {
    "js": {
      "exports": [
        "open_pdf",
        "process_cmyk_to_rgb",
        "open_pdf_with_password",
        "set_font_fallbacks",
        "render_page",
        "render_print_page",
        "page_layouts",
        "cache_info",
        "select_text",
        "select_page_text",
        "search_pdf",
        "document_info",
        "download_attachment",
        "download_metadata",
        "close_pdf",
        "xfa_data",
        "xfa_font_glyphs",
        "range_open",
        "range_section",
        "range_next_section",
        "range_missing",
        "range_object_request",
        "range_object",
        "range_document",
        "range_object_dependencies",
        "range_cache_info",
        "search_page",
        "editor_info",
        "prepare_editor",
        "apply_edits",
        "save_pdf",
      ],
      "format": "esm",
    },
  },
)
