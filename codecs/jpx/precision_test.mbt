    b"\x00\x00\x00\x0c\x6a\x50\x20\x20\x0d\x0a\x87\x0a\x00\x00\x00\x45\x6a\x70\x32\x68\x00\x00\x00\x0f\x63\x6f\x6c\x72\x01\x00\x00\x00\x00\x00\x10\x00\x00\x00\x1a\x70\x63\x6c\x72\x00\x04\x03\x07\x07\x07\xff\x00\x00\x00\xff\x00\x00\x00\xff\x28\x50\x78\x00\x00\x00\x14\x63\x6d\x61\x70\x00\x00\x01\x00\x00\x00\x01\x01\x00\x00\x01\x02\x00\x00\x00\x89\x6a\x70\x32\x63\xff\x4f\xff\x51\x00\x29\x00\x00\x00\x00\x00\x07\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x07\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\xff\x52\x00\x0c\x00\x00\x00\x01\x00\x00\x04\x04\x00\x01\xff\x5c\x00\x04\x40\x10\xff\x64\x00\x25\x00\x01\x43\x72\x65\x61\x74\x65\x64\x20\x62\x79\x20\x4f\x70\x65\x6e\x4a\x50\x45\x47\x20\x76\x65\x72\x73\x69\x6f\x6e\x20\x32\x2e\x35\x2e\x33\xff\x90\x00\x0a\x00\x00\x00\x00\x00\x17\x00\x01\xff\x93\xdd\x1c\x06\x01\x77\x60\x4d\x09\x3f\xff\xd9",
  ).unwrap()
  assert_eq(samples.components, 3)
  assert_eq(samples.bits, 8)
  assert_eq(samples.colour_hint, "RGB")
  assert_eq(
    samples.bytes,
    b"\xff\x00\x00\x28\x50\x78\x00\x00\xff\x00\xff\x00\xff\x00\x00\x28\x50\x78\x00\x00\xff\x00\xff\x00\xff\x00\x00\x28\x50\x78\x00\x00\xff\x00\xff\x00\xff\x00\x00\x28\x50\x78\x00\x00\xff\x00\xff\x00\xff\x00\x00\x28\x50\x78\x00\x00\xff\x00\xff\x00\xff\x00\x00",
  )
}

///|
test "sYCC subsampling matches OpenJPEG colour conversion" {
  let s = @jpx.decode(
    b"\x00\x00\x00\x0c\x6a\x50\x20\x20\x0d\x0a\x87\x0a\x00\x00\x00\x14\x66\x74\x79\x70\x6a\x70\x32\x20\x00\x00\x00\x00\x6a\x70\x32\x20\x00\x00\x00\x2d\x6a\x70\x32\x68\x00\x00\x00\x16\x69\x68\x64\x72\x00\x00\x00\x03\x00\x00\x00\x07\x00\x03\x07\x07\x00\x00\x00\x00\x00\x0f\x63\x6f\x6c\x72\x01\x00\x00\x00\x00\x00\x12\x00\x00\x00\xb7\x6a\x70\x32\x63\xff\x4f\xff\x51\x00\x2f\x00\x00\x00\x00\x00\x07\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x07\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x03\x07\x01\x01\x07\x02\x02\x07\x02\x02\xff\x52\x00\x0c\x00\x00\x00\x01\x00\x00\x04\x04\x00\x01\xff\x5c\x00\x04\x40\x40\xff\x64\x00\x25\x00\x01\x43\x72\x65\x61\x74\x65\x64\x20\x62\x79\x20\x4f\x70\x65\x6e\x4a\x50\x45\x47\x20\x76\x65\x72\x73\x69\x6f\x6e\x20\x32\x2e\x35\x2e\x33\xff\x90\x00\x0a\x00\x00\x00\x00\x00\x3f\x00\x01\xff\x93\xdf\x80\xb0\x06\xce\xca\x91\xfc\xe7\xe7\xd4\xef\x0c\x91\x45\x7f\x4e\x98\x87\x78\x8f\x75\xd9\xb7\x1f\xc7\xd4\x10\x06\x40\x99\xe0\xf6\xef\x91\xdf\xcf\xb4\x28\x0b\x35\x90\x41\x41\x20\x5f\x5a\x91\x3f\xff\xd9",
  ).unwrap()
  assert_eq(
    s.bytes,
    b"\x13\x09\x00\x26\x1c\x00\x54\x1c\x00\x67\x2f\x00\x94\x2e\x2b\xa7\x41\x3e\xd5\x40\x72\x48\x3e\x00\x5b\x51\x00\x89\x51\x18\x9c\x64\x2b\xc9\x63\x60\xdc\x76\x73\xff\x75\xa7\xc7\x3c\x63\xda\x4f\x76\xff\x4e\xaa\xff\x61\xbd\xff\x60\xf2\xff\x73\xff\xff\x72\xff",
  )
  assert_eq(s.colour_hint, "RGB")
}
