///|
fn change_bytes(data : Bytes, at : Int, replacement : Bytes) -> Bytes {
  Bytes::makei(data.length(), i => {
    if i >= at && i - at < replacement.length() {
      replacement[i - at]
    } else {
      data[i]
    }
  })
}

///|
fn tiny_rgb() -> Bytes {
  // Lossless 3x2 RGB JP2, generated by Pillow/OpenJPEG; source samples are
  // tested separately. Keeping this local makes malformed tests deterministic.
  b"\x00\x00\x00\x0c\x6a\x50\x20\x20\x0d\x0a\x87\x0a\x00\x00\x00\x14\x66\x74\x79\x70\x6a\x70\x32\x20\x00\x00\x00\x00\x6a\x70\x32\x20\x00\x00\x00\x2d\x6a\x70\x32\x68\x00\x00\x00\x16\x69\x68\x64\x72\x00\x00\x00\x02\x00\x00\x00\x03\x00\x03\x07\x07\x00\x00\x00\x00\x00\x0f\x63\x6f\x6c\x72\x01\x00\x00\x00\x00\x00\x10\x00\x00\x00\xa7\x6a\x70\x32\x63\xff\x4f\xff\x51\x00\x2f\x00\x00\x00\x00\x00\x03\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x03\x07\x01\x01\x07\x01\x01\x07\x01\x01\xff\x52\x00\x0c\x00\x00\x00\x01\x00\x00\x04\x04\x00\x01\xff\x5c\x00\x04\x40\x40\xff\x64\x00\x25\x00\x01\x43\x72\x65\x61\x74\x65\x64\x20\x62\x79\x20\x4f\x70\x65\x6e\x4a\x50\x45\x47\x20\x76\x65\x72\x73\x69\x6f\x6e\x20\x32\x2e\x35\x2e\x34\xff\x90\x00\x0a\x00\x00\x00\x00\x00\x2f\x00\x01\xff\x93\xdf\x80\x40\x0e\x30\xd9\xb4\x5c\xe3\x8d\x4f\xdf\x80\x40\x07\x6e\x9a\x97\x67\x6d\x15\x26\xdf\x80\x40\x06\x4b\x54\xa1\x35\x5e\xf0\x7a\xff\xd9"
}

///|
test "all truncated prefixes reject before entropy decode" {
  let bytes = tiny_rgb()
  for n in 0..<bytes.length() {
    assert_true(decode(bytes[0:n].to_owned()) is Err(_))
  }
}

///|
test "bad box sizes and huge SIZ dimensions are bounded" {
  let bytes = tiny_rgb()
  for
    replacement in [
      b"\x7f\xff\xff\xff", b"\xff\xff\xff\xff", b"\x00\x00\x00\x02",
    ] {
    assert_true(decode(change_bytes(bytes, 0, replacement)) is Err(_))
  }
  let stream = header(bytes, true).codestream
  for offset in [8, 12, 24, 28] {
    assert_true(
      decode(change_bytes(stream, offset, b"\x7f\xff\xff\xff")) is Err(_),
    )
  }
  assert_true(decode(change_bytes(stream, 24, b"\x00\x00\x00\x00")) is Err(_))
}

///|
test "budget failures are explicit and alpha mode is validated" {
  let data = tiny_rgb()
  let limits = default_limits()
  assert_true(decode(data, limits={ ..limits, max_input_bytes: 1, }) is Err(_))
  assert_true(decode(data, limits={ ..limits, max_pixels: 1, }) is Err(_))
  assert_true(decode(data, limits={ ..limits, max_samples: 1, }) is Err(_))
  assert_true(decode(data, smask_in_data=3) is Err(_))
}

///|
test "non-byte sample storage preserves source precision and row padding" {
  for bits in [1, 2, 3, 4, 5, 7, 8, 9, 12, 15, 16] {
    let row_bytes = (5 * bits + 7) / 8
    let bytes = FixedArray::make(row_bytes * 2, b'\x00')
    let max_value = (1 << bits) - 1
    for y in 0..<2 {
      for x in 0..<5 {
        put_sample(
          bytes,
          y * row_bytes * 8 + x * bits,
          bits,
          (x + y * 3) & max_value,
        )
      }
    }
    for y in 0..<2 {
      for x in 0..<5 {
        assert_eq(
          read_packed(bytes, y * row_bytes * 8 + x * bits, bits),
          (x + y * 3) & max_value,
        )
      }
    }
  }
}

///|
test "signed little-endian component samples normalize exactly once" {
  let p : @jpeg2000.Component = {
    width: 4,
    height: 1,
    bits: 16,
    signed: true,
    bytes: b"\x00\x80\xff\xff\x00\x00\xff\x7f",
  }
  assert_eq([ for i in 0..<4 => component_sample(p, i) ], [
    0, 32767, 32768, 65535,
  ])
}

///|
test "ICC bytes survive JP2 metadata and PDF colour override" {
  let raw = header(tiny_rgb(), true).codestream
  let profile = Bytes::make(128, b'\x00')
  // A length-valid profile is handed to the ICC engine for semantic validity.
  let colr = b"\x00\x00\x00\x8bcolr\x02\x00\x00" + profile
  let length = raw.length() + 8
  let box = Bytes::makei(8, i => {
    if i < 4 {
      ((length >> (24 - i * 8)) & 255).to_byte()
    } else {
      b"jp2c"[i - 4]
    }
  })
  let data = b"\x00\x00\x00\x0cjP  \x0d\x0a\x87\x0a\x00\x00\x00\x93jp2h" +
    colr +
    box +
    raw
  let decoded = decode(data).unwrap()
  assert_eq(decoded.colour_hint, "ICC")
  assert_eq(decoded.embedded_icc_profile, Some(profile))
  let overridden = decode(data, use_embedded_colour=false).unwrap()
  assert_eq(overridden.colour_hint, "Unknown")
  assert_eq(overridden.embedded_icc_profile, None)
}
